//make dot "/dot/ulagfx";
make dot "ulagfx.dot";

include "io.znc"
include "printf.znc"
include "memory.znc"

void wait_scanline(int line) __znccall(1) __asm__ {
  pop hl
  pop de
  push hl

  ld bc,0x243b        ; B = 0x24 (NextReg select), C = 0x3B (NextReg data)

  ; Select Active video line LSB (0x1F)
  ld a,0x1f
  out (c),a
  inc b               ; B = 0x25 → data port

  ; If we're already on the target line, skip this occurrence:
  ; stay in this loop while LSB == E, i.e. until we leave that line.
.skip
  in a,(c)
  cp e
  jr z,.skip          ; wait while LSB == target

  ; Main wait: find next time (MSB,LSB) == (D,E)
.wait:
  dec b               ; select port
  ld a,0x1f           ; LSB register
  out (c),a
  inc b               ; data port
.lsb:
  in a,(c)
  cp e
  jr nz,.lsb          ; wait for LSB == E

  dec b               ; select port
  ld a,0x1e           ; MSB register
  out (c),a
  inc b               ; data port
.msb:
  in a,(c)
  cp d
  jr nz,.wait         ; if MSB != D, start over with LSB

  ret
}

void setpixel(int x, int y) __znccall(1) __asm__ {
  pop hl
  pop bc
  pop de
  push hl

  ld d,c     ; D = y
  pixelad
  setae
  or (hl)
  ld (hl),a

  ret
}

void line(int x0, int y0, int x1, int y1) {
  int dx=abs(x1-x0);
  int sx=x0<x1?1:-1;
  int dy=-abs(y1-y0);
  int sy=y0<y1?1:-1;

  int err=dx+dy;
  for(;;) {
    setpixel(x0, y0);
    int e2=err<<1;
    if (e2>=dy) {
      if (x0==x1) break;
      err=err+dy;
      x0=x0+sx;
    }
    if (e2<=dx) {
        if (y0==y1) break;
        err=err+dx;
        y0=y0+sy;
    }
  }
}

void circle(int xc, int yc, int r) {
  int r2=r+r;
  int x=r;
  int y=0;
  int dy=-2;
  int dx=r2+r2-4;
  int d=r2-1;
  while(y<=x) {
    setpixel(xc+x, yc+y);
    setpixel(xc-x, yc+y);
    setpixel(xc+x, yc-y);
    setpixel(xc-x, yc-y);
    setpixel(xc+y, yc+x);
    setpixel(xc-y, yc+x);
    setpixel(xc+y, yc-x);
    setpixel(xc-y, yc-x);

    d=d+dy;
    dy=dy-4;
    y=y+1;
    int mask=d>>31;
    d=d+(dx & mask);
    dx=dx-(4 & mask);
    x=x+mask;  
  }
}

nextreg(7,3);

// clear the screen
memset(16384,0,6144);

// draw the ruler markings
for(int y=0;y<160;y=y+10) {
  line(0,y,25,y);
  for (int yy=y+2;yy<y+10 && yy<192;yy=yy+2) {
    line(0,yy,10,yy);
  }
}

byte scanline = 0;
void update_view() {
  gotoxy(5,0);
  printf("Scanline: %d   ", scanline);
}

__asm__{
    di
 }
gotoxy(0,21); puts("Q/A-change scanline   SPACE-exit");
update_view();
for(;;) {
  wait_scanline(scanline);
  out(0xfe,1);
  circle(88,80,30);
  out(0xfe,2);
  line(30,30,50,30);
  out(0xfe,3);
  line(30,30,46,19);

  out(0xfe,7);
  if ((in(0xfbfe) & 0x01) == 0) {
    // 'Q' pressed
    --scanline;
    update_view();
  } else if ((in(0xfdfe) & 0x01) == 0) {
    // 'A' pressed
    ++scanline;
    update_view();
  }
  if ((in(0x7ffe) & 0x01) == 0) break;
}
 __asm__{
    ei
 }
