make dot "a.dot";

void wait_scanline(int line) __znccall(1) __asm__ {
_
  pop hl
  pop de
  push hl

  ld bc,0x243b        ; B = 0x24 (NextReg select), C = 0x3B (NextReg data)

  ; Select Active video line LSB (0x1F)
  ld a,0x1f
  out (c),a
  inc b               ; B = 0x25 → data port

  ; If we're already on the target line, skip this occurrence:
  ; stay in this loop while LSB == E, i.e. until we leave that line.
.skip
  in a,(c)
  cp e
  jr z,.skip          ; wait while LSB == target

  ; Main wait: find next time (MSB,LSB) == (D,E)
.wait:
  dec b               ; select port
  ld a,0x1f           ; LSB register
  out (c),a
  inc b               ; data port
.lsb:
  in a,(c)
  cp e
  jr nz,.lsb          ; wait for LSB == E

  dec b               ; select port
  ld a,0x1e           ; MSB register
  out (c),a
  inc b               ; data port
.msb:
  in a,(c)
  cp d
  jr nz,.wait         ; if MSB != D, start over with LSB

  ret
}

__asm__{
    di
 }

for(;;) {
  wait_scanline(0);
  out(0xfe,1);
  for(int i=0; i<256; ++i) {
  }
  out(0xfe,2);
  for(uint16 i=0; i<256; ++i) {
  }
  out(0xfe,7);
  
  if ((in(0x7ffe) & 0x01) == 0) break;
}
 __asm__{
    ei
 }

