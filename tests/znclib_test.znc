make dot "znclib_test.dot";

include "dotn.znc"
include "io.znc"

int pass_count = 0;
int fail_count = 0;

void test_cmdline() bank(1);
void test_ctype() bank(2);
void test_memory() bank(3);
void test_string() bank(4);
void test_strtoint() bank(5);

void check(char *name, byte result) {
  ink(0);
  puts(name);
  if (result) {
    ink(4);
    puts(":OK\r");
    pass_count++;
  } else {
    ink(2);
    puts(":FAIL\r");
    fail_count++;
  }
  ink(0);
}

puts("ZNC library tests\r=================\r");
test_cmdline();
test_ctype();
test_memory();
test_string();
test_strtoint();
puts("=================\rPASS: ");
printnum(pass_count);
puts("\rFAIL: ");
printnum(fail_count);
puts("\r");

bank(1) {
  include "cmdline.znc"

  void test_cmdline() {
    char[48] command = "  one \"two three\" \"four\"\"five\" \"six\"  ";
    char*[4] argv;
    byte argc = parse_cmdline(command, argv, 4);

    check("cmd_argc", argc == 4);
    check("cmd_arg0", argv[0][0] == 'o' && argv[0][1] == 'n' && argv[0][2] == 'e' && argv[0][3] == 0);
    check("cmd_arg1", argv[1][0] == 't' && argv[1][1] == 'w' && argv[1][2] == 'o' && argv[1][3] == ' ' && argv[1][8] == 'e' && argv[1][9] == 0);
    check("cmd_arg2", argv[2][0] == 'f' && argv[2][4] == '"' && argv[2][8] == 'e' && argv[2][9] == 0);
    check("cmd_arg3", argv[3][0] == 's' && argv[3][1] == 'i' && argv[3][2] == 'x' && argv[3][3] == 0);

    char[8] limited = "a b c";
    char*[2] limited_argv;
    check("cmd_maxargs", parse_cmdline(limited, limited_argv, 2) == 2);

    char[1] empty = "";
    char*[1] empty_argv;
    check("cmd_empty", parse_cmdline(empty, empty_argv, 1) == 0);

    char[8] spaces = "   ";
    char*[1] spaces_argv;
    check("cmd_spaces", parse_cmdline(spaces, spaces_argv, 1) == 0);
  }
}

bank(2) {
  include "ctype.znc"

  void test_ctype() {
    check("ctype_digit", isdigit('7') && !isdigit('x'));
    check("ctype_alpha", isalpha('A') && isalpha('z') && !isalpha('7'));
    check("ctype_alnum", isalnum('A') && isalnum('8') && !isalnum('-'));
    check("ctype_lanum", islanum('a') && islanum('9') && !islanum('Z'));
    check("ctype_upper", isupper('Q') && !isupper('q'));
    check("ctype_lower", islower('q') && !islower('Q'));
    check("ctype_xdigit", isxdigit('f') && isxdigit('B') && !isxdigit('g'));
    check("ctype_space", isspace(' ') && isspace('\n') && !isspace('A'));
    check("ctype_print", isprint(' ') && isprint('~') && !isprint(31));
    check("ctype_punct", ispunct('!') && !ispunct('A') && !ispunct(' '));
    check("ctype_edges", isdigit('0') && isdigit('9') && !isdigit('/'));
    check("ctype_ranges", isalpha('Z') && isalpha('a') && !isalpha('['));
    check("ctype_hexedge", isxdigit('0') && isxdigit('F') && isxdigit('f') && !isxdigit('G'));
    check("ctype_punct2", ispunct('/') && ispunct(':') && ispunct('@') && ispunct('`') && ispunct('~'));
    check("ctype_lower", to_lower('G') == 'g' && to_lower('g') == 'g');
    check("ctype_upper", to_upper('g') == 'G' && to_upper('G') == 'G');
    check("ctype_identity", to_lower('!') == '!' && to_upper('!') == '!');
  }
}

bank(3) {
  include "memory.znc"

  void test_memory() {
    byte[6] source = {1, 2, 3, 4, 5, 6};
    byte[6] target;
    memcpy(target, source, 6);
    check("memory_memcpy", target[0] == 1 && target[5] == 6);

    byte[7] moved = {1, 2, 3, 4, 5, 6, 7};
    memmove(&moved[1], moved, 6);
    check("memory_memmove", moved[0] == 1 && moved[1] == 1 && moved[6] == 6);

    memset(target, 0x5a, 6);
    check("memory_memset", target[0] == 0x5a && target[5] == 0x5a);

    int[4] words;
    memset16(words, 0x1234, 4);
    check("memory_set16", words[0] == 0x1234 && words[3] == 0x1234);

    memset(target, 0, 0);
    check("mem_zero_len", target[0] == 0x5a);

    byte[6] forward = {1, 2, 3, 4, 5, 6};
    memmove(&forward[1], forward, 5);
    check("mem_move_fwd", forward[0] == 1 && forward[1] == 1 && forward[5] == 5);

    byte[6] backward = {1, 2, 3, 4, 5, 6};
    memmove(backward, &backward[1], 5);
    check("mem_move_back", backward[0] == 2 && backward[4] == 6 && backward[5] == 6);

    int[1] one;
    memset16(one, 0xabcd, 1);
    check("mem_set16_one", one[0] == 0xabcd);
  }
}

bank(4) {
  include "string.znc"
  include "strcontains.znc"

  void test_string() {
    char[16] copied;
    strcpy(copied, "hello");
    check("string_strcpy", strcmp(copied, "hello") == 0);
    check("string_strlen", strlen(copied) == 5);
    check("string_strcmp", strcmp("abc", "abc") == 0 && strcmp("abc", "abd") < 0 && strcmp("abd", "abc") > 0);

    char[16] joined;
    strcpy(joined, "foo");
    strcat(joined, "bar");
    check("string_strcat", strcmp(joined, "foobar") == 0);

    char[16] haystack = "one two three";
    char[4] needle = "two";
    char[1] empty = "";
    char[4] letters = "abc";
    check("string_strstr", strstr(haystack, needle) == haystack + 4);
    check("strstr_empty", strstr(haystack, empty) == haystack);
    check("string_strchr", strchr(letters, 'b') == letters + 1 && strchr(letters, 'x') == 0);
    check("string_empty", strlen(empty) == 0 && strcmp(empty, "") == 0);
    check("string_prefix", strstr(haystack, "one") == haystack);
    check("string_suffix", strchr(letters, 'c') == letters + 2);
    check("contains_yes", strcontains(haystack, needle));
    check("contains_no", !strcontains(haystack, "four"));
    check("contains_empty", strcontains(haystack, empty));
    check("contains_long", !strcontains("ab", "abcd"));
  }
}

bank(5) {
  include "strtoint.znc"

  void test_strtoint() {
    char[8] pos = "1234";
    char[8] neg = "-321";
    char[8] plus = "+77";
    char[16] space = " \t-42rest";
    char[12] stop = "99bottles";
    char[4] zero = "0";
    check("strtoint_pos", strtoint(pos) == 1234);
    check("strtoint_neg", strtoint(neg) == -321);
    check("strtoint_plus", strtoint(plus) == 77);
    check("strtoint_space", strtoint(space) == -42);
    check("strtoint_stop", strtoint(stop) == 99);
    check("strtoint_zero", strtoint(zero) == 0);
    char[1] empty = "";
    char[5] onlyspace = " \t\r";
    check("strtoint_empty", strtoint(empty) == 0);
    check("strtoint_blank", strtoint(onlyspace) == 0);
  }
}