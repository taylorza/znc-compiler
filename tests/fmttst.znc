make dot "fmttst.dot";
include "string.znc"
include "printf.znc"
include "sprintf.znc"
include "io.znc"

// Runs sprintf() and checks output against expected.
void check(char* fmt, char* expected, void* arg) {
    char[128] buf;

    sprintf(buf, fmt, arg);
    
    if (strcmp(buf, expected) != 0) {
        ink(2);
        printf("FAIL fmt=\"%s\"\r", fmt);
        printf("  got:      \"%s\"\r", buf);
        printf("  expected: \"%s\"\r", expected);
    } else {
        ink(4);
        printf("PASS fmt=\"%s\" -> \"%s\"\r", fmt, buf);
    }
    ink(0);
}

void run_tests() {
    // %d — signed decimal
    check("%d", "0", 0);
    check("%d", "1234", 1234);
    check("%d", "-1234", -1234);
    check("%5d", "   42", 42);
    check("%05d", "00042", 42);
    
    // %x / %X — hexadecimal
    check("%x", "0", 0);
    check("%x", "1234", 0x1234);
    check("%X", "ABCD", 0xABCD);
    check("%08x", "00000042", 0x42);

    // %b — binary
    check("%b", "00000000", 0);
    check("%b", "01010101", 0x55);
    check("%b", "1010101010101010", 0xAAAA);
    check("%16b", "0001001000110100", 0x1234);

    // %f — fixed‑point 12.4
    check("%f", "0.0", 0);
    check("%f", "1.0", 0x0010);
    check("%f", "15.0", 0x00F0);
    check("%f", "18.1875", 0x0123);
    check("%f", "-18.1875", -0x0123);

    // %c — character
    check("%c", "A", 'A');
    check("%5c", "Z    ", 'Z');
    
    // %s — string
    check("%s", "Hello", "Hello");
    check("%10s", "Hi        ", "Hi");
    
    // %% — literal percent
    check("%%", "%", 0);
    check("Value: %% %d", "Value: % 42", 42);
}

run_tests();
