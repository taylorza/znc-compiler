#ifndef TILEMAP__
const byte TILEMAP__=1;

include "zxn.znc"
include "memory.znc"
include "fileio.znc"
include "mmu.znc"

enum TIL_MODE {
  TIL_40x32 = 0,
  TIL_80x32 = 0b01000000,
}

const uint TIL_TILEMAP = 0xc000;
const byte TIL_HEIGHT = 32;
uint TIL_TILEDEF;
byte TIL_MAX_TILES;
byte TIL_WIDTH;

byte* _til_ptr = TIL_TILEMAP;

byte TIL_TILE_OFFS = (TIL_TILEDEF - TIL_TILEMAP) >> 8;

byte _til_bank;
byte _til_save_4c;
byte _til_save_6b;
byte _til_save_6c;

byte _til_mode;

void til_init(TIL_MODE mode) __znccall(1) {
  _til_mode = mode;

  if (mode == TIL_MODE.TIL_80x32) {
    TIL_TILEDEF = 0xca00;
    TIL_WIDTH = 80;
  } else {
    TIL_TILEDEF = 0xc500;
    TIL_WIDTH = 40;
  }
  TIL_MAX_TILES = (0x2000 - (TIL_WIDTH * TIL_HEIGHT)) >> 5;
  TIL_TILE_OFFS = (TIL_TILEDEF - TIL_TILEMAP) >> 8;

  nextreg(0x56, 14); // Switch to bank 7 (page 14)

  _til_bank = readreg(0x56);
  _til_save_4c = updatereg(0x4c, 0x0f);               // Tilemap transparent index
  _til_save_6b = updatereg(0x6b, 0b10100001 | _til_mode);  // Tilmap Control
  _til_save_6c = updatereg(0x6c, 0b00000000);         // Default Attribute

  nextreg(0x6e, 0x80);                  // Tilemap Bank 7 offset 0x0000
  nextreg(0x6f, 0x80 | TIL_TILE_OFFS);  // Tiledef Bank 7 offset 0x0a00 

  // Set tilemap defaults
  // Reset clip window
  nextreg(0x1c, 0b00001000);      // Reset tilemap clip index
  nextreg(0x1b, 0);               // X1 - 0
  nextreg(0x1b, 159);             // X2 - 318
  nextreg(0x1b, 0);               // Y1 - 0
  nextreg(0x1b, 255);             // Y1 - 255

  // Reset scroll offsets
  nextreg(0x2f, 0);               // X Scroll offset - MSB
  nextreg(0x30, 0);               // X Scroll offset - LSB
  nextreg(0x31, 0);               // Y Scroll offset

  byte *tiledef = TIL_TILEDEF;
  *tiledef = {
    0x00,0xee,0xee,0x00,
    0x0e,0xee,0xee,0xe0,
    0xee,0xee,0xee,0xee,
    0xee,0xee,0xee,0xee,
    0xee,0xee,0xee,0xee,
    0xee,0xee,0xee,0xee,
    0x0e,0xee,0xee,0xe0,
    0x00,0xee,0xee,0x00,
  };
}

void til_cls(byte tile) __znccall(1) {
  memset(TIL_TILEMAP, tile, TIL_WIDTH * TIL_HEIGHT);
}

void til_load(char *filename, byte count) __znccall(1) {
  byte fh = fopen(filename, M_EXIST | M_READ);
  fread(fh, TIL_TILEDEF, count*32);
  fclose(fh); 
}

void til_loadmap(char *filename) __znccall(1) {
  byte fh = fopen(filename, M_EXIST | M_READ);
  fread(fh, TIL_TILEMAP, TIL_WIDTH*TIL_HEIGHT);
  fclose(fh); 
}

enum PALETTE {
  ULA_1     = 0b00000000,
  ULA_2     = 0b01000000,
  Layer2_1  = 0b00010000,
  Layer2_2  = 0b01010000,
  Sprite_1  = 0b00100000,
  Sprite_2  = 0b01100000,
  Tilemap_1 = 0b00110000,
  Tilemap_2 = 0b01110000, 
}

void pal_load(PALETTE palette, char *filename) __znccall(1) {
  byte fh = fopen(filename, M_EXIST | M_READ);

  byte page = mmualloc();
  if (page == 255) {
    fclose(fh);
    return;
  }

  byte oldpage = updatereg(0x56, page);
  fread(fh, 0xc000, 512);
  fclose(fh);

  byte ctlpal = readreg(0x43);
  nextreg(0x43, (ctlpal & 0b10001111) | palette); 
  nextreg(0x40, 0);
  for(byte *p = 0xc000; p < 0xc000+512; ++p){
    nextreg(0x44, *p);
  }
  nextreg(0x56, oldpage);
  mmufree(page);  
}

void pal_select(PALETTE palette) __znccall(1) {
  byte ctlpal = readreg(0x43);
  byte ctltil = readreg(0x6b);

  if (palette == PALETTE.Sprite_1) ctlpal &= ~(1 << 3);
  else if (palette == PALETTE.Sprite_2) ctlpal |= (1 << 3);
  else if (palette == PALETTE.Layer2_1) ctlpal &= ~(1 << 2);
  else if (palette == PALETTE.Layer2_2) ctlpal |= (1 << 2);
  else if (palette == PALETTE.ULA_1) ctlpal &= ~(1 << 1);
  else if (palette == PALETTE.ULA_2) ctlpal |= (1 << 1);
  else if (palette == PALETTE.Tilemap_1) ctltil &= ~(1 << 4);
  else if (palette == PALETTE.Tilemap_2) ctltil |= (1 << 4);

  nextreg(0x43, ctlpal); 
  nextreg(0x6b, ctltil);
}

void til_set(byte x, byte y, byte tile) __znccall(1) {
  if (x >= TIL_WIDTH || y >= TIL_HEIGHT) return;
  _til_ptr[(y * TIL_WIDTH) + x] = tile;
}

byte til_get(byte x, byte y) __znccall(1) {
  if (x >= TIL_WIDTH || y >= TIL_HEIGHT) return 0;
  return _til_ptr[(y * TIL_WIDTH) + x];
}

void til_restore() __znccall(1) {
  nextreg(0x4c, _til_save_4c);  
  nextreg(0x6b, _til_save_6b);
  nextreg(0x6c, _til_save_6c);
  nextreg(0x56, _til_bank);
}

#endif