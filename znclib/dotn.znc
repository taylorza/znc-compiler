#ifndef DOTN__
const byte DOTN__=1;

/*
  Supports multi-bank DOT programs on the ZX Spectrum Next.
  At startup, reads each banked page from the dot file into a newly allocated MMU page,
  building a page map (bank ID -> MMU page) for runtime lookups.
  All allocated pages are freed automatically on exit via atexit().
*/

include "dot.znc"
include "fileio.znc"
include "mmu.znc"

byte[255] _page_map;
byte _page_count;
__asm__ {
  ld a,PAGE_COUNT
  ld (__page_count),a
}

void _dotn_cleanup();

{
  void* init_bank = 0x8000;

  byte fh = fgethandle();
  byte old_mmu4 = readreg(0x54);
  for(int i=0; i < _page_count; i++) {  
    byte mmu = mmualloc();    
    nextreg(0x54, mmu);
    errno = 0;
    int bytes_read = fread(fh, 0x8000, 0x2000);
    if (errno) {
      nextreg(0x54, old_mmu4);
      _dotn_cleanup();
      exit("DOTN load failed");    
    }
    byte *id = 0x9fff;
    _page_map[*id] = mmu;
    init_bank();
  }
  nextreg(0x54, old_mmu4);

  atexit(_dotn_cleanup);
}

void _dotn_cleanup() {
  for(int i=0; i < 255; i++) {
    if (_page_map[i]) {
      mmufree(_page_map[i]);
    }
  }
}


#endif // DOTN__