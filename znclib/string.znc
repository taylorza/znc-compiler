#ifndef STRING__
const byte STRING__=1;

char* strcpy(char *dst, char *src) __znccall(1) __asm__ {
  pop bc  ; return value
  pop hl  ; source
  pop de  ; destination

  push bc ; restore return address

  xor a ; <------ Was missing
.n
  cp (hl)
  ldi
  jr nz,.n

.x
  ret
}

int strlen(char *s) __znccall(1) __asm__ {
  pop bc ; return address
  pop hl ; string pointer

  push bc ; restore return address
  
  xor a
  ld c,a
  ld b,a

  cpir
  ld hl, 0xffff
  sbc hl,bc

  ret
}

int strcmp(char *s1, char *s2) __znccall(1) __asm__ {
  pop bc  ; return address
  pop hl  ; s2
  pop de  ; s1
  push bc ; restore return address

.l
  ld a,(de)
  cpi
  jr nz,.n
  inc de
  or a
  jr nz,.l
  
  ld h,a
  ld l,a
  ret

.n
  dec hl
  sub (hl)
  ld h,a

  ret
}

char* strcat(char *s1, char *s2) __znccall(1) __asm__ {
  pop bc  ; return address
  pop hl  ; s2
  pop de  ; s1

  push bc ; restore return address
 
  push de ; save s1 pointer
.z
  ld a,(de)
  or a
  jr z,.l
  inc de
  jr .z

.l
  cp (hl)
  ldi
  jr nz,.l

  pop hl ; return s1 pointer
  ret
}

char* strstr(char *s1, char *s2) __znccall(1) __asm__ {
_
  pop bc          ; return address
  pop de          ; DE = s2 (needle)
  pop hl          ; HL = s1 (haystack)
  push bc         ; restore return address

  ld a,(de)       ; needle empty?
  or a
  jr z,.ret_hs    ; return haystack

.outer
  ld a,(hl)       ; haystack ended?
  or a
  jr z,.nf        ; no match

  ld a,(de)       ; needle[0]
  cp (hl)         ; haystack[i] ?
  jr nz,.next

  ; possible match starting at HL
  push hl         ; save haystack start
  push de         ; save needle start

  inc hl
  inc de

.inner
  ld a,(de)       ; needle[j]
  or a
  jr z,.yes       ; full match

  cp (hl)         ; haystack[i+j] ?
  jr nz,.restore

  inc hl
  inc de
  jr .inner

.restore
  pop de          ; restore needle
  pop hl          ; restore haystack
.next
  inc hl          ; advance haystack
  jr .outer

.yes
  pop de
  pop hl
  ret             ; HL = match position

.ret_hs
  ret             ; HL already = haystack

.nf
  ld hl,0
  ret
}


char* strchr(char *str, char ch) __znccall(1) __asm__ {
_
  pop bc      ; Pop return address
  pop de      ; Pop 'ch' into DE
  pop hl      ; Pop 'str' into HL
  push bc     ; Restore return address

.loop
  ld a,(hl)
  cp e
  ret z

  inc hl

  or a        
  jr nz,.loop

  ld hl,0
  ret
}
#endif