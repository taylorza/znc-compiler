#ifndef DOT__
const byte DOT__ = 1;

delegate void PFN_EXIT();

void seterrh(PFN_EXIT fn) __znccall(1) __asm__ {
    pop bc
    pop hl
    push bc

    rst $08
    db $95
    ret
}

int atexit(PFN_EXIT fn) __znccall(1) __asm__ {
    pop bc
    pop de
    push bc

    ld hl,0
    ld a,(ccexit.cnt)
    cp 4
    ret z

    ld b,a
    add a

    ld hl, __exitfn
    add hl,a
    ld (hl),e
    inc hl
    ld (hl),d

    ld a,b
    inc a
    ld (ccexit.cnt),a

    ld hl,1
    ret
}

#endif // DOT__