#ifndef IO__
const byte IO__=1;

void ink(byte c) __znccall(1) __asm__  {
  pop hl    ; Pop return address
  pop bc    ; Pop c into C
  push hl   ; Push return address back

  ld a,16   ; INK
  rst 16

  ld a,c    ; c
  rst 16
  
  ret
}

void paper(byte c) __znccall(1) __asm__  {
  pop hl    ; Pop return address
  pop bc    ; Pop c into C
  push hl   ; Push return address back

  ld a,17   ; PAPER
  rst 16

  ld a,c    ; c
  rst 16
  
  ret
}

void gotoxy(byte x, byte y) __znccall(1) __asm__ {
  pop hl    ; Pop return address
  pop bc    ; Pop y into C
  pop de    ; Pop x into E
  push hl   ; Push return address back

  ld a,22   ; AT 
  rst 16

  ld a,c    ; y
  rst 16
  
  ld a,e    ; x
  rst 16
  ret
}

byte wherex() __asm__{
  ld a,34
  ld hl, 0x5c88
  sub (hl)
  ld l,a
  ld h,0
  ret
}

byte wherey() __asm__ {
  ld a,25
  ld hl, 0x5c89
  sub (hl)
  ld l,a
  ld h,0
  ret
}

void printnum(int n) {
  if (n==0) { putc('0'); return; }

  if (n<0) {
    putc('-');
    n=-n;
  }
  
  int div=10000;  
  while((n/div)==0) {
    div=div/10;
  }
  
  while(div) {
    putc(n/div+'0');
    n=n%div;			
    div=div/10;
  }
}

char inkey() __asm__ {
  ld hl,0
  bit 5,(iy+1)
  ret z
  res 5,(iy+1)
  ld a,($5c08)
  ld l,a
  ret 
}

char waitkey() __asm__ {
  ld hl,0
checkkey
  halt
  bit 5,(iy+1)
  jr z, checkkey
  res 5,(iy+1)
  ld a,($5c08)
  ld l,a
  ret
}

#endif