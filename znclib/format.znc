#ifndef FORMAT__
const byte FORMAT__=0x01;

/* Shared formatting core with a pluggable sink function.
   PFN_PUTC is called for every output character along with a context pointer. */

delegate void PFN_PUTC(char ch, void* ctx);

/* shared scratch buffers moved to file scope to avoid allocating on the stack
   for each vsprintf call; reduces stack frame size and codegen. */
char[6] _buf_g;
char[4] _hbuf_g;
char[4] _fbuf_g;

void emit_pad(PFN_PUTC sink, void* ctx, char ch, int count) __znccall(1) {
  while (count > 0) { sink(ch, ctx); --count; }
}

void emit_rev_buf(PFN_PUTC sink, void* ctx, char *buf, int count) __znccall(1) {
  while (count > 0) { --count; sink(buf[count], ctx); }
}

void vsprintf(PFN_PUTC sink, void* sink_ctx, char *fmt, va_list args) __znccall(1) {
  int i = 0;
  /* use file-scope shared buffers directly to avoid per-call locals */

  /* common temporaries reused across format cases */
  int x, neg, p, content_len, pad_count, bit, bits, len;
  char *sx;

  while (fmt[i] != 0) {
    char ch = fmt[i];
    if (ch != '%') { sink(ch, sink_ctx); ++i; continue; }

    char code = fmt[++i];
    if (code == '%') { sink('%', sink_ctx); ++i; continue; }

    /* flags */
    char pad = ' ';
    while (code == '0') { pad = '0'; code = fmt[++i]; }

    /* width (no dynamic '*' support) */
    int width = 0;
    while (fmt[i] != 0 && (code >= '0' && code <= '9')) { width = (width * 10) + (code - '0'); code = fmt[++i]; }

    switch (code) {
      case 'd': {
        x = va_arg(args, int);
        int ux;
        if (x < 0) { neg = 1; ux = -x; } else { neg = 0; ux = x; }
        p = 0;
        if (ux == 0) { _buf_g[p++] = '0'; }
        else { int tmp = ux; while (tmp != 0) { _buf_g[p++] = '0' + (tmp % 10); tmp = tmp / 10; } }
        content_len = p + (neg ? 1 : 0);
        pad_count = (width > content_len) ? width - content_len : 0;
        if (pad == '0' && neg) { sink('-', sink_ctx); emit_pad(sink, sink_ctx, '0', pad_count); }
        else { emit_pad(sink, sink_ctx, pad, pad_count); if (neg) sink('-', sink_ctx); }
        emit_rev_buf(sink, sink_ctx, _buf_g, p);
        break;
      }
      case 'x':
      case 'X': {
        x = va_arg(args, int);
        p = 0;
        if (x == 0) { _hbuf_g[p++] = '0'; }
        else {
          int ux = x;
          while (ux != 0) {
            int digit = ux & 0x0f;
            if (digit < 10) _hbuf_g[p++] = '0' + digit;
            else _hbuf_g[p++] = (code == 'X' ? 'A' : 'a') + (digit - 10);
            ux = (ux >> 4) & 0x0fff;
          }
        }
        content_len = p;
        pad_count = (width > content_len) ? width - content_len : 0;
        emit_pad(sink, sink_ctx, pad, pad_count); emit_rev_buf(sink, sink_ctx, _hbuf_g, p);
        break;
      }
      case 'f': {
        int ip_len, fp_len, fstart;
        x = va_arg(args, int);
        int v = x; int negf = 0;
        if (v < 0) { negf = 1; v = -v; }
        int ipart = v >> 4;
        int frac_dec = (v & 0x0f) * 625;
        ip_len = 0;
        if (ipart == 0) { _buf_g[ip_len++] = '0'; }
        else { while (ipart > 0) { _buf_g[ip_len++] = '0' + (ipart % 10); ipart = ipart / 10; } }
        fp_len = 0; while (fp_len < 4) { _fbuf_g[fp_len++] = '0' + (frac_dec % 10); frac_dec = frac_dec / 10; }
        neg = negf;
        fstart = 0; while (fstart < fp_len - 1 && _fbuf_g[fstart] == '0') ++fstart;
        int frac_len = fp_len - fstart;
        content_len = ip_len + 1 + frac_len + (neg ? 1 : 0);
        pad_count = (width > content_len) ? width - content_len : 0;
        if (pad == '0' && neg) { sink('-', sink_ctx); emit_pad(sink, sink_ctx, '0', pad_count); }
        else { emit_pad(sink, sink_ctx, pad, pad_count); if (neg) sink('-', sink_ctx); }
        emit_rev_buf(sink, sink_ctx, _buf_g, ip_len);
        sink('.', sink_ctx);
        emit_rev_buf(sink, sink_ctx, _fbuf_g + fstart, fp_len - fstart);
        break;
      }
      case 'b': {
        x = va_arg(args, int);
        bit = (x >= 0 && x < 256) ? 7 : 15; bits = bit + 1;
        pad_count = (width > bits) ? width - bits : 0;
        emit_pad(sink, sink_ctx, pad, pad_count); for (; bit >= 0; --bit) sink((x & (1 << bit)) ? '1' : '0', sink_ctx);
        break;
      }
      case 'c': {
        x = va_arg(args, int);
        pad_count = (width > 1) ? width - 1 : 0;
        emit_pad(sink, sink_ctx, pad, pad_count); sink(x, sink_ctx);
        break;
      }
      case 's': {
        sx = va_arg(args, char*);
        len = 0; char *siter = sx; while (*siter) { ++len; ++siter; }
        pad_count = (width > len) ? width - len : 0;
        if (pad_count) emit_pad(sink, sink_ctx, pad, pad_count);
        while (*sx) { sink(*sx++, sink_ctx); }
        break;
      }
      default:
        sink('%', sink_ctx);
        sink(code>32 && code < 128 ? code : '?', sink_ctx);
        break;
    }

    ++i;
  }
}

#endif
